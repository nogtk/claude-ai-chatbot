# Docker Compose 環境変数の例
# 別のファイル名 (.env.docker など) として保存するか、
# docker-compose.yml の environment セクションで直接設定してください

# Anthropic API キー（必須）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# データベース URL（docker-compose の場合）
# ローカルホスト開発時: mongodb://localhost:27017/ai-chatbot
# Docker Compose 環境: mongodb://mongodb:27017/ai-chatbot

# Node 環境
NODE_ENV=development

# Google Cloud（デプロイ時のみ）
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=asia-northeast1
